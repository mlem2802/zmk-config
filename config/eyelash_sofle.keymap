#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Layer IDs
#define STANDARD 0
#define UTILITY  1
#define LIGHTING 2

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

{
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

{
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&zip_temp_layer 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &td0
            >;
        };
    };
};

// Bottom left key is the encoder click
// Column 7 (middle column) is the joystick from the right half

    keymap {
        compatible = "zmk,keymap";
//
// STANDARD layout
//
        standard {
            bindings = <
&kp ESC     &kp N1        &kp N2       &kp N3        &kp N4         &kp N5               &kp UP                 &kp N6     &kp N7         &kp N8         &kp N9        &kp N0          &kp BSPC
&kp TAB     &kp Q         &kp W        &kp E         &kp R          &kp T                &kp DOWN               &kp Y      &kp U          &kp I          &kp O         &kp P           &kp BSLH
&kp GRAVE   &kp A         &kp S        &kp D         &kp F          &kp G                &kp LEFT               &kp H      &kp J          &kp K          &kp L         &kp SEMI        &kp APOS
&kp LCTRL   &kp Z         &kp X        &kp C         &kp V          &kp B                &kp RIGHT              &kp N      &kp M          &kp COMMA      &kp DOT       &kp FSLH        &kp ENTER
&kp C_MUTE                &kp LSHIFT    &kp LGUI      &kp LALT      &zip_temp_layer 1    &kp SPACE              &kp LEFT   &kp DOWN       &kp RIGHT      &kp UP        &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "STANDARD";
        };

        Utility {
            bindings = <
&to MAC     &kp F1           &kp F2          &kp F3           &kp F4           &kp F5                   &mmv MOVE_UP               &kp F6           &kp F7        &kp F8         &kp F9         &kp F10       &trans
&trans      &none            &kp UP          &mkp LCLK        &mkp MCLK        &mkp RCLK                &mmv MOVE_DOWN             &kp PG_UP        &kp LC(LEFT)  &kp UP         &kp LC(RIGHT)  &kp MINUS     &kp EQUAL
&trans      &kp LEFT         &kp DOWN        &kp RIGHT        &none            &mkp MB5                 &mmv MOVE_LEFT             &kp PG_DN        &kp LEFT      &kp DOWN       &kp RIGHT      &kp LBKT      &kp RBKT
&trans      &none            &none           &none            &none            &none                    &mmv MOVE_RIGHT            &rgb_ug RGB_BRI  &kp HOME      &kp END        &kp C_VOL_DN   &kp C_VOL_UP  &trans
&kp C_MUTE                   &trans          &trans           &trans           &trans          &trans   &mkp LCLK        &trans    &trans           &trans        &trans         &trans
            >;

            display-name = "UTILITY";
            sensor-bindings = <&scroll_encoder>;
        };
//
// LIGHTING layout
//
        lighting {
            bindings = <
&trans     &trans           &trans           &trans            &trans             &trans                      &trans             &trans           &trans          &trans          &trans            &trans             &trans
&trans     &trans           &trans           &trans            &trans             &trans                      &trans             &trans           &trans          &trans          &trans            &trans             &trans
&trans     &trans           &trans           &trans            &trans             &trans                      &trans             &trans           &trans          &trans          &trans            &trans             &trans
&trans     &trans           &trans           &trans            &trans             &trans                      &trans             &trans           &trans          &trans          &trans            &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LIGHTING";
        };
void matrix_scan_user(void) {
  #ifdef RGBLIGHT_ENABLE

  static uint8_t old_layer = 255;
  uint8_t new_layer = biton32(layer_state);

  if (old_layer != new_layer) {
    switch (new_layer) {
      case STANDARD:
        &rgb_ug RGB_COLOR_HSB(255,100,100);
        break;
      case UTILITY:
        rgb_ug RGB_COLOR_HSB(128,100,100);
        break;
      case LIGHTING:
        rgb_ug RGB_COLOR_HSB(200,100,100);
        break;
    }

    old_layer = new_layer;
  }

  #endif //RGBLIGHT_ENABLE
}

    };
};
